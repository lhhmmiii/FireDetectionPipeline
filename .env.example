# =============================================================================
# Fire Detection Pipeline — Environment Variables
# Copy this file to .env and adjust values for your environment.
# =============================================================================

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_FRAMES=frames
KAFKA_TOPIC_DETECTIONS=detections
KAFKA_TOPIC_TRACKS=tracks
KAFKA_TOPIC_METRICS=metrics

# --- RTSP ---
RTSP_URL=rtsp://mediamtx:8554/stream
RTSP_RECONNECT_DELAY=5
RTSP_MAX_RETRIES=0

# --- Frame Extractor ---
FRAME_EXTRACT_FPS=10
FRAME_RESIZE_WIDTH=640
FRAME_RESIZE_HEIGHT=480
FRAME_SKIP_ON_OVERLOAD=true

# --- Detection ---
DETECTION_MODEL_PATH=models/rfdetr-nano-int8.engine
DETECTION_CONFIDENCE_THRESHOLD=0.5
DETECTION_DEVICE=cuda
DETECTION_BATCH_SIZE=1

# --- Tracking ---
TRACKING_MAX_AGE=30
TRACKING_MIN_HITS=3
TRACKING_IOU_THRESHOLD=0.3

# --- Dashboard ---
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
WEBRTC_URL=http://mediamtx:8889
# Comma-separated source_id:stream_name pairs, one per video panel.
DASHBOARD_STREAMS=camera-1:stream1,camera-2:stream2

# --- Media Gateway (MediaMTX) ---
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_API_PORT=9997

# --- Metrics / Monitoring ---
METRICS_ENABLED=true
MONITORING_HOST=0.0.0.0
MONITORING_PORT=8090
METRICS_WINDOW_SECONDS=60
MONITORING_BASELINE_DIR=/app/data/baselines

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
